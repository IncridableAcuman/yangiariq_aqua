# ==============================================================================
# YANGIARIQ AQUA AI - Production Environment Configuration Reference Template
# Milestone 08.21: Production Deployment, Security Hardening & Operational Readiness
# ==============================================================================
# Copy this file to .env.prod on your production server.
# NEVER commit the actual .env.prod file with production credentials to Git!
# All sensitive variables below MUST be populated with high-entropy production values.

# ------------------------------------------------------------------------------
# 1. Application & Compose Runtime
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
COMPOSE_PROJECT_NAME=yangiariq-aqua-prod
IMAGE_TAG=0.8.21

# ------------------------------------------------------------------------------
# 2. Domain & TLS Configuration
# ------------------------------------------------------------------------------
# The fully qualified domain name pointing to the production server edge IP
DOMAIN_NAME=aqua.yangiariq.uz
# Frontend public API base URL (relative for edge reverse proxy routing)
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------------------
# 3. PostgreSQL Production Database Configuration
# ------------------------------------------------------------------------------
# Database container network coordinates (internal to Docker bridge network)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aquaai
DB_USERNAME=aqua_admin
# MUST be a strong, randomly generated alphanumeric password (min 16+ chars)
# Default 'aqua_secure_password_dev' is strictly rejected at application startup
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PRODUCTION_PASSWORD

# HikariCP Connection Pool Settings
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 4. Authentication, Security & JWT Token Configuration
# ------------------------------------------------------------------------------
# MUST be a cryptographically secure 512-bit Base64-encoded secret (min 64 chars)
# In production, default development secret is strictly rejected at startup
# Generate using: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_CRYPTO_SECURE_64_BYTE_BASE64_SECRET

# Access Token Validity in milliseconds (default 3600000 = 1 hour, max 86400000 = 24 hours)
JWT_ACCESS_TOKEN_EXPIRATION=3600000

# Refresh Token Validity in milliseconds (default 604800000 = 7 days, max 2592000000 = 30 days)
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Strict CORS Allowed Origins (Comma-separated HTTPS origins; localhost is strictly rejected)
CORS_ALLOWED_ORIGINS=https://aqua.yangiariq.uz

# Sliding Window Rate Limiting (Token-Bucket per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30

# ------------------------------------------------------------------------------
# 5. Root Super Administrator (SUPER_ADMIN) Controlled Bootstrap
# ------------------------------------------------------------------------------
# Set to 'true' only during the initial platform initialization.
# Permanently ignored and disabled once an active Super Administrator exists.
# Password must be at least 12 chars with upper, lower, digit, and symbol.
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_BOOTSTRAP_EMAIL=
SUPER_ADMIN_BOOTSTRAP_PASSWORD=
SUPER_ADMIN_BOOTSTRAP_PHONE=+998900000001
SUPER_ADMIN_BOOTSTRAP_FIRST_NAME=Super
SUPER_ADMIN_BOOTSTRAP_LAST_NAME=Administrator

# ------------------------------------------------------------------------------
# 6. Disaster Recovery & Backup Configuration
# ------------------------------------------------------------------------------
BACKUP_DIR=./backups/postgres
RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# 7. External Integrations & Telemetry Providers
# ------------------------------------------------------------------------------
# AI Provider (Options: mock, gemini) - decision support only, actuation strictly forbidden
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Sensor Telemetry Provider (Options: simulated, mqtt, http)
SENSOR_PROVIDER=simulated

# External Weather Provider (Open-Meteo Khorezm regional telemetry)
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1/forecast

# ------------------------------------------------------------------------------
# 8. Logging & API Documentation
# ------------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_AQUAAI=INFO
# Keep Swagger disabled in production to avoid exposing internal schemas
ENABLE_SWAGGER_PROD=false
