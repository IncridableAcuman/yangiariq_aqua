# ==============================================================================
# YANGIARIQ AQUA AI - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.prod on your production server.
# NEVER commit the actual .env.prod file with production credentials to Git!

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=yangiariq-aqua-prod
IMAGE_TAG=0.8.18

# Domain & TLS Configuration
DOMAIN_NAME=aqua.yangiariq.uz

# PostgreSQL Production Database
# Use strong, randomly generated passwords (minimum 16+ alphanumeric characters)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aquaai
DB_USERNAME=aqua_admin
DB_PASSWORD=REPLACE_WITH_STRONG_GENERATED_PRODUCTION_PASSWORD

# Security & JWT Configuration
# MUST be a strong, cryptographically secure 512-bit Base64-encoded secret.
# In production, default development secret is REJECTED on startup!
# Generate using: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_CRYPTO_SECURE_64_BYTE_BASE64_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# CORS Allowed Origins
# MUST be your actual HTTPS domain(s). Localhost is REJECTED in production profile.
CORS_ALLOWED_ORIGINS=https://aqua.yangiariq.uz

# Database Pool Configuration
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Rate Limiting Configuration
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30

# External AI Provider (Optional)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Sensor Telemetry Provider
SENSOR_PROVIDER=simulated

# API Documentation
# Keep false in production to prevent exposing internal endpoints
ENABLE_SWAGGER_PROD=false
