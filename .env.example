# ==============================================================================
# YANGIARIQ AQUA AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the development environment.
# NEVER commit the actual .env file with secrets into version control.

# Application Environment
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
# You can specify individual components or the full connection URL:
DATABASE_URL=jdbc:postgresql://localhost:5432/yangiariq_aqua
DATABASE_USERNAME=aqua_user
DATABASE_PASSWORD=aqua_secure_password_dev

# Fallback components for Docker container bridging
DB_HOST=localhost
DB_PORT=5432
DB_NAME=yangiariq_aqua
DB_USER=aqua_user
DB_PASSWORD=aqua_secure_password_dev

# Liquibase Settings
LIQUIBASE_ENABLED=true
LIQUIBASE_DROP_FIRST=false

# Security & JWT Configuration
# Generate a secure 512-bit Base64-encoded secret for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D635166546A576E5A7234753778214125442A
JWT_ACCESS_TOKEN_EXPIRATION=86400000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# CORS Allowed Origins (comma-separated list of frontends)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Provider Configuration (Options: mock, gemini)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Sensor Provider Configuration (Options: simulated, mqtt, http)
SENSOR_PROVIDER=simulated
SENSOR_SIMULATION_INTERVAL_MS=30000

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_DEFAULT_LANGUAGE=uz
VITE_APP_NAME="Yangiariq Aqua AI"
